+    /** Erase the exact entry of a reverted zone change without creating a new one. */
+    public final void removeRollbackEntry(Card card, ZoneType origin) {
+        if (!cardsAddedThisTurn.get(origin).removeIf(added -> added.equalsWithGameTimestamp(card))) {
+            return;
+        }
+        // The live card ID can have an earlier entry in this zone this turn.
+        // Restore its origin using the latest remaining zone-change timestamp.
+        enteredFromThisTurn.keySet().removeIf(added -> added.equals(card));
+        Card previous = null;
+        ZoneType previousOrigin = null;
+        for (var entry : cardsAddedThisTurn.entries()) {
+            Card added = entry.getValue();
+            if (added.equals(card) && (previous == null || added.getGameTimestamp() > previous.getGameTimestamp())) {
+                previous = added;
+                previousOrigin = entry.getKey();
+            }
+        }
+        if (previous != null) {
+            enteredFromThisTurn.put(previous, previousOrigin);
+        }
+    }
+
