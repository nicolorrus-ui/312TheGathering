+    private boolean mayPlayAllowsThisFace(Card land, Player player) {
+        StaticAbility granting = getMayPlay();
+        if (granting == null || !granting.hasParam("Affected")) {
+            return true;
+        }
+        CardState face = getCardState();
+        CardStateName faceName = face == null ? null : face.getStateName();
+        CardStateName previous = land.getCurrentStateName();
+        boolean switched = false;
+        try {
+            if (faceName != null && !faceName.equals(previous) && land.hasState(faceName)) {
+                switched = land.setState(faceName, false);
+            }
+            return land.isValid(granting.getParam("Affected").split(","), player, granting.getHostCard(), granting);
+        } finally {
+            if (switched) {
+                land.setState(previous, false);
+            }
+        }
     }
 
     @Override
